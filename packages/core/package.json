{
  "name": "@mcp-ssdlc/core",
  "version": "1.0.0",
  "description": "Shared types, utilities, and validators for MCP SSDLC Security Toolkit",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "date-fns": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "tsup": "^8.0.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}