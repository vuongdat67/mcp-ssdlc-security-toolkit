{
  "name": "@mcp-ssdlc/security-kb",
  "version": "1.0.0",
  "description": "Security knowledge base with CVE, CWE, and OWASP data for MCP SSDLC Toolkit",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
