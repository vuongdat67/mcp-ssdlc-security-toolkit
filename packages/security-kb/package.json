    "@mcp-ssdlc/core": "workspace:*",
    "fast-xml-parser": "^5.3.3",
    "sql.js": "^1.10.3",
    "stream-chain": "^3.4.0",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/sql.js": "^1.4.9",
    "@types/stream-json": "^1.7.8",
    "tsup": "^8.0.1",
    "typescript": "^5.9.0"
  }
