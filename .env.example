# Example environment variables for MCP SSDLC Security Toolkit
# Copy this to .env and fill in your values

# ============================================================================
# Core Settings
# ============================================================================

# Node environment: development | test | production
NODE_ENV=development

# Logging level: debug | info | warn | error
LOG_LEVEL=debug

# ============================================================================
# Database Settings
# ============================================================================

# Path to security knowledge base (default: packages/security-kb/data/security.db)
# SECURITY_DB_PATH=./data/security.db

# ============================================================================
# API Keys (Optional - for future integrations)
# ============================================================================

# GitHub API token (for repository scanning)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# NVD API key (for CVE updates) - get from https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================================================
# AI/LLM Settings (Optional - for AI-powered explanations)
# ============================================================================

# OpenAI API key (for enhanced explanations)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Azure OpenAI settings
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=xxxxxxxx

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Prometheus metrics port
# METRICS_PORT=9090

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug features
# DEBUG=mcp-ssdlc:*

# Watch mode for auto-rebuild
# WATCH=true
